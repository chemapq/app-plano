---

interface Props {
	title: string;
}
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
        <meta name="format-detection" content="telephone=no">
		<meta charset="UTF-8" />
		<meta name="description" content="Un plano 3D que incluye todo el contenido digital necesario para mostrar la vivienda de una forma interactiva." />
		<meta name="viewport" content="width=device-width" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5">
		<meta name="msapplication-TileColor" content="#da532c">
		<meta name="theme-color" content="#ffffff">
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
		<title>{title}</title>
		<!-- <ViewTransitions /> -->
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
/* ===== Scrollbar CSS ===== */
/* Firefox */
* {
    scrollbar-width: auto;
    scrollbar-color: hsl(230, 100%, 89%) transparent;
}

/* Chrome, Edge, and Safari */
*::-webkit-scrollbar {
    width: 6px;
}

*::-webkit-scrollbar-track {
    background: transparent;
}

*::-webkit-scrollbar-thumb {
    background-color: hsl(230, 100%, 89%);
    border-radius: 33px;
    border: 0px inset red;
}

:root {
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
    --accent-gradient: linear-gradient(
        45deg,
        rgb(var(--accent)),
        rgb(var(--accent-light)) 30%,
        white 60%
    );
    overflow: visible;
}

html {
    background-color: hsl(240, 15%, 17%);
    font-family: "Poppins", sans-serif;
    font-weight: 400;
    font-style: normal;
}

main {
    margin: 0;
    padding: 0;
    width: 100%;
    background-color: hsl(240, 15%, 17%);
}

code {
    font-family:
        Menlo,
        Monaco,
        Lucida Console,
        Liberation Mono,
        DejaVu Sans Mono,
        Bitstream Vera Sans Mono,
        Courier New,
        monospace;
}

body {
    display: flex;
    flex-direction: row;
    height: 100vh;
    margin: 0;
    padding: 0;
    background-color: hsl(240, 15%, 17%);
}

.fixed-navbar {
    color: white;
    width: 18vw;
    padding-left: 8px;
    min-width: fit-content;
    display: flex;
    flex-direction: column;
    padding-top: 8px;
    align-items: center;
    font-size: 1rem;
    border-right: hsla(228, 100%, 99%, 0.1) solid 0px;
    height: 100dvh;
    align-items: flex-start;
    gap: 8px;
}

.navlink {
    display: flex;
    color: white;
    text-decoration: none;
    padding: 1.4dvh;
    border-radius: 12px;
    align-items: center;
}

.navlink svg {
    padding-right: 8px;
}

.hamburger-link {
    display: flex;
    color: white;
    text-decoration: none;
    padding: 4px;
    border-radius: 12px;
    align-items: center;
}

.hamburger-link svg {
    padding-right: 8px;
}

.icon-list {
    margin: 0;
    padding: 0;
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: 2dvh;
    max-width: 250px;
    width: 18vw;
    min-width: fit-content;
    overflow-y: auto;
}

.icon-list {
    padding-bottom: 1dvh;
}

.logo {
    font-size: 2rem;
    color: white;
    text-decoration: none;
    padding-left: 8px;
}

.logo span {
    color: hsl(230, 100%, 69%);
}

.navlink:hover {
    outline-offset: -1px;
    outline: solid 1px hsl(230, 100%, 69%);
}

.active {
    background-color: hsl(230, 100%, 69%);
    color: hsl(0, 0%, 100%);
}

.active svg {
    fill: hsl(0, 0%, 100%);
}

.poppins-bold {
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-style: normal;
}

.poppins-regular {
    font-family: "Poppins", sans-serif;
    font-weight: 400;
    font-style: normal;
}

/* Dot navigation for image gallery */
.dots-footer {
    position: absolute;
    bottom: 8px;
    margin-inline: auto;
    left: 0;
    right: 0;
}

.dotstyle {
    position: relative;
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    cursor: default;
    justify-content: center;
    gap: 16px;
}

.dotstyle li {
    position: relative;
    display: block;
    float: left;
    margin: 0;
    width: 16px;
    height: 16px;
    cursor: pointer;
}

.dotstyle li a {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    outline: none;
    border-radius: 50%;
    background-color: red;
    background-color: rgba(214, 16, 16, 0.3);
    text-indent: -999em;
    cursor: pointer; /* make the text accessible to screen readers */
    position: absolute;
}

.dotstyle-fillup li a {
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    box-shadow: inset 0 0 0 2px hsl(230, 100%, 69%);
    transition: background 0.3s;
}

.dotstyle-fillup li a::after {
    content: '';
    position: absolute;
    bottom: 0;
    height: 0;
    left: 0;
    width: 100%;
    background-color: hsl(230, 100%, 89%);
    box-shadow: 0 0 1px hsl(230, 100%, 89%);
    transition: height 0.3s;
}

.dotstyle-fillup li a:hover,
.dotstyle-fillup li a:focus {
    background-color: hsl(230, 100%, 89%);
}

.dotstyle-fillup li.current a::after {
    height: 100%;
}

.hamburger-icon {
    fill: white;
    display: none;
}

.hamburger-icons {
    list-style-type: none;
    padding-left: 8px;
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.hamburger-dialog {
    height: 0px;
    top: 80px;
    width: 100vw;
    position: absolute;
    z-index: 99;
    background-color: hsl(240, 15%, 17%);
    display: none;
}

.hamburger-list {
    font-size: 1.5rem;
}
.filter-text {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.8rem;
    color: hsl(240, 15%, 97%);
    margin-left: 16px;
    margin-right: 16px;
    list-style: none;
    padding: 0;
}

.filter-text li {
    white-space: nowrap;
}
.filter-negrita {
    font-weight: bold;
}

.contact-icon {
    position: fixed;
    bottom: 16px;
    right: 16px;
    background-color: hsl(240, 15%, 27%);
    color: hsl(240, 15%, 97%);
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    transition: background-color 0.3s;
    width: 64px;
    height: 64px;
    display: flex; 
    justify-content: center;
    align-items: center;
    
}

.contact-icon:hover {
    background-color: hsl(240, 15%, 37%);
}

#contact-modal {
    border: none;
    border-radius: 8px;
    padding: 16px;
    background-color: hsl(240, 15%, 27%);
    color: hsl(240, 15%, 97%);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
}

.closeButton {
    position: absolute;
    top: 8px;
    right: 8px;
    background: none;
    border: none;
    color: hsl(240, 15%, 97%);
    font-size: 1.5rem;
    cursor: pointer;
}
.telefono {
    text-decoration: none;
    color: hsl(240, 15%, 97%);
}
.fixed-navbar::before {
  align-self: stretch;
  content: '';
  border: 1px solid hsl(240, 15%, 37%);
}
.fixed-navbar .logo {
  order: -2;
}
.fixed-navbar .filter-text {
    order: -1;
}

@media (orientation: portrait) {
    .fixed-navbar::before {
         border: none;
}
    body {
        flex-direction: column;
        overflow: hidden;
    }

    .fixed-navbar {
        height: 80px;
        flex-direction: row;
        width: 100vw;
        align-items: center;
        padding: 0;
        border-bottom: solid 1px hsl(240, 15%, 37%);
        justify-content: space-between;
        flex-grow: 0;
        gap: 0px;
    }

    .icon-list {
        display: none;
    }

    .hamburger-icon {
        display: initial;
        padding-right: 16px;
        height: 32px;
        transition: 0.4s;
    }

    .hamburger-icon-rotated {
        transform: rotate(90deg) translateX(7px) translateY(8px);
        transition: 0.4s;
    }

    .logo {
        padding-left: 16px;
    }

    .hamburger-open {
        height: calc(100vh - 80px);
        display: flex;
    }
    .filter-text {
        display: none;
    }
}

@media (max-width: 1200px) {
    .long-nav {
        display: none;
    }
}
</style>
<script type="module">
const hamburgerMenu = document.querySelector(".hamburger-dialog")
const hamburgerIcon = document.querySelector(".hamburger-icon")

hamburgerIcon.addEventListener("click",()=>{
	if (hamburgerMenu.classList.contains("hamburger-open")){
		hamburgerMenu.classList.remove("hamburger-open")
		hamburgerIcon.classList.remove("hamburger-icon-rotated")

	}
	else{
		hamburgerMenu.classList.add("hamburger-open")
		hamburgerIcon.classList.add("hamburger-icon-rotated")
	}
})

const contactButton = document.getElementById('contact-button');
const contactModal = document.getElementById('contact-modal');
const closeButton = contactModal.querySelector('.closeButton');

contactButton.addEventListener('click', () => {
	contactModal.showModal();
});

closeButton.addEventListener('click', () => {
	contactModal.close();
});

contactModal.addEventListener('click', (event) => {
	if (event.target === contactModal) {
		contactModal.close();
	}
});
</script>